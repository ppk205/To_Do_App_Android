# ========================================
# MOPR Backend - Environment Configuration
# ========================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=mopr_db

# Redis Configuration (for OTP and optional token blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-different-from-jwt-secret
REFRESH_TOKEN_PEPPER=your-token-hash-pepper-for-hmac-change-in-production

# Token TTLs (in seconds)
ACCESS_TOKEN_TTL_SECONDS=1800        # 30 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000    # 30 days

# OTP Configuration
OTP_HMAC_SECRET=your-otp-hmac-secret-change-in-production

# Email Configuration (SMTP)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password-from-gmail

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ========================================
# Security Best Practices
# ========================================

# 1. Generate strong random secrets:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 2. For Gmail SMTP:
#    - Enable 2FA on your Google account
#    - Generate App Password at: https://myaccount.google.com/apppasswords

# 3. For Production:
#    - Use AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault
#    - Enable HTTPS/TLS only
#    - Use RS256 for JWT (asymmetric keys)
#    - Enable rate limiting
#    - Add certificate pinning in mobile app

# 4. Rotate secrets periodically (every 90 days recommended)


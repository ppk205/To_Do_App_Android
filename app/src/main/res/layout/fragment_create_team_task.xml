<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Task"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnCreateTask"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/LabelStyle"
                android:text="Task Name" />
            <EditText
                android:id="@+id/etTaskName"
                style="@style/InputStyle"
                android:hint="Enter task name" />

            <TextView
                style="@style/LabelStyle"
                android:layout_marginTop="16dp"
                android:text="Description" />
            <EditText
                android:id="@+id/etDescription"
                style="@style/InputStyle"
                android:gravity="top"
                android:hint="Describe the task in detail"
                android:minHeight="120dp" />

            <TextView
                style="@style/LabelStyle"
                android:layout_marginTop="16dp"
                android:text="Assigned Members" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMember"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Add/Remove Members"
                android:textAllCaps="false"
                android:textColor="#212121"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:strokeColor="#E0E0E0" />

            <TextView
                style="@style/LabelStyle"
                android:layout_marginTop="16dp"
                android:text="Due Date" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/etDueDate"
                    style="@style/InputStyle"
                    android:focusable="false"
                    android:hint="June 25, 2024" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_calendar" />
            </FrameLayout>

            <TextView
                style="@style/LabelStyle"
                android:layout_marginTop="16dp"
                android:text="Priority" />
            <Spinner
                android:id="@+id/spinnerPriority"
                style="@style/InputStyle"
                android:layout_height="56dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAttachFile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Attach File"
                android:textAllCaps="false"
                android:textColor="#212121"
                app:backgroundTint="#F5F5F5"
                app:icon="@drawable/ic_attach"
                app:iconGravity="textStart"
                app:iconTint="#757575" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateTask"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Create Task"
        android:textAllCaps="false"
        app:backgroundTint="#29B6F6"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
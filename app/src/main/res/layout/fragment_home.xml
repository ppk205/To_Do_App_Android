<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Status bar space (fake) -->
    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Tiêu đề và action -->
    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Personal To-Dos"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/status_bar_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <ImageView
        android:id="@+id/btn_search"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Search"
        android:src="@android:drawable/ic_menu_search"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title"
        app:layout_constraintEnd_toStartOf="@id/btn_more"
        android:layout_marginEnd="8dp"
        app:tint="#000000" />

    <ImageView
        android:id="@+id/btn_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="More"
        android:src="@drawable/ic_menu_handle_custom"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#000000" />

    <!-- Divider -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Tabs -->
    <HorizontalScrollView
        android:id="@+id/scroll_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="#FAFAFF"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/header_divider">
        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:text="All"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#29B6F6"
                android:textStyle="bold"
                android:textSize="18sp"
                android:checkedIconVisible="false"
                android:checkable="true"
                android:checked="true"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chip.Rounded"/>
            <com.google.android.material.chip.Chip
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:text="To Do"
                android:textColor="#222222"
                app:chipBackgroundColor="#F5F5F5"
                android:textStyle="bold"
                android:textSize="18sp"
                android:checkedIconVisible="false"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chip.Rounded"/>
            <com.google.android.material.chip.Chip
                android:layout_width="130dp"
                android:layout_height="44dp"
                android:text="In Progress"
                android:textColor="#222222"
                app:chipBackgroundColor="#F5F5F5"
                android:textStyle="bold"
                android:textSize="18sp"
                android:checkedIconVisible="false"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chip.Rounded"/>
            <com.google.android.material.chip.Chip
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:text="Done"
                android:textColor="#222222"
                app:chipBackgroundColor="#F5F5F5"
                android:textStyle="bold"
                android:textSize="18sp"
                android:checkedIconVisible="false"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chip.Rounded"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:id="@+id/scroll_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="#FAFAFF"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_tabs">
        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true">
            <com.google.android.material.chip.Chip
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:text="Date"
                app:chipIcon="@drawable/ic_calendar_custom"
                app:chipIconTint="#333333"
                app:chipBackgroundColor="#F5F5F5"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="18sp"
                style="@style/Widget.MaterialComponents.Chip.Action"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chip.Rounded"/>
            <com.google.android.material.chip.Chip
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:text="Priority"
                app:chipIcon="@drawable/ic_flag"
                app:chipIconTint="#333333"
                app:chipBackgroundColor="#F5F5F5"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="18sp"
                style="@style/Widget.MaterialComponents.Chip.Action"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chip.Rounded"/>
            <com.google.android.material.chip.Chip
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:text="Tag"
                app:chipIcon="@drawable/ic_tag"
                app:chipIconTint="#333333"
                app:chipBackgroundColor="#F5F5F5"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="18sp"
                style="@style/Widget.MaterialComponents.Chip.Action"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Chip.Rounded"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/scroll_filters"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_task"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_fab"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="30dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#29B6F6"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/img_fab_add_custom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="15dp"
            android:src="@drawable/ic_plus"
            app:tint="#FFFFFF"
            android:contentDescription="Add New Task" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Content centered in screen -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Success Icon -->
        <ImageView
            android:id="@+id/img_success_reset"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_check_circle"
            android:contentDescription="@string/success"
            app:tint="@color/success" />

        <!-- Title -->
        <TextView
            android:id="@+id/txt_reset_success_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_password_success_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="24dp"
            android:gravity="center" />

        <!-- Subtitle message -->
        <TextView
            android:id="@+id/txt_reset_success_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_password_success_message"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginTop="12dp"
            android:gravity="center" />

        <!-- Action card (optional info) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/light_gray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txt_security_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_password_security_note"
                    android:textSize="13sp"
                    android:textColor="@color/dark_gray" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Continue to Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue_login_reset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="@string/continue_to_login"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/brand_blue" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

